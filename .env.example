# Copy to .env (git-ignored) before `docker compose up`.

# REQUIRED. Shared secret every broker-to-broker frame must carry.
# Generate one with:  openssl rand -hex 32
HERMES_CLUSTER_SECRET=

# Recommended. Clients must send this as the X-API-Key header. Empty = REST API is open.
HERMES_API_KEY=

# Optional overrides (defaults shown):
# HERMES_CORS_ORIGINS=http://localhost:3000
# HERMES_ACKS=all              # all = quorum-durable; leader = faster, can lose acked writes
# HERMES_GROUP_COMMIT=true     # coalesce fsyncs across concurrent producers
# HERMES_LINGER_MS=2
# HERMES_PEER_TIMEOUT_MS=3000   # raise (e.g. 10000) if large batches or slow disks cause 502 'Read timed out'
